OPENROUTER_API_KEY=
GITHUB_TOKEN=
# Reports need a database (cost caps): a Neon Postgres connection string, or memory for an
# in-memory one built at startup; see server/src/db/schema.ts
DATABASE_URL=memory
# Feature flags: on turns a flag on; unset, empty or off leaves it off (production default).
# FEATURE_ACCOUNTS can also be a comma-separated list of GitHub logins: on only for those users.
FEATURE_REPORT_LINKS=on
FEATURE_ACCOUNTS=on
# GitHub sign-in (needed while FEATURE_ACCOUNTS is not off): the local GitHub OAuth app, whose
# callback is http://localhost:5173/api/auth/callback/github (see docs/hosting.md)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# At least 32 random characters, for example from: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The origin the browser uses: the Vite dev server, which proxies /api to the server
BETTER_AUTH_URL=http://localhost:5173
